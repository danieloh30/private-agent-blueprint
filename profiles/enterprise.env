# Enterprise-private profile (default for the talk): Red Hat enMaaS gateway, OpenAI-compatible.
# No credential in this file. BLUEPRINT_MODEL_API_KEY_ENV names the shell variable that holds the key;
# scripts/start.sh copies it into BLUEPRINT_MODEL_API_KEY for the agent process only.
BLUEPRINT_MODEL_BASE_URL=https://api.enmaas.devshift.net/v1
BLUEPRINT_MODEL_APPROVED_HOSTS=api.enmaas.devshift.net
# Open-weights model served through the gateway. Any tool-calling model it lists works, e.g.
# rits/zai-org/glm-5-3 or gpt-5.4-mini; list them with: scripts/doctor.sh --models
BLUEPRINT_MODEL_NAME=rits/deepseek-ai/DeepSeek-V4.1-Flash-1017
BLUEPRINT_MODEL_API_KEY_ENV=ENMAAS_KEY
