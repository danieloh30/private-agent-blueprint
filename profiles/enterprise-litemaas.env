# Enterprise-private profile: Red Hat LiteMaaS (LiteLLM-based, OpenAI-compatible) gateway.
# No credential in this file. The API key is read from BLUEPRINT_MODEL_API_KEY,
# or from LITEMAAS_API_KEY (the variable OpenCode uses) by scripts/start.sh.
BLUEPRINT_MODEL_BASE_URL=https://litemaas.rhoai.rh-aiservices-bu.com/v1
BLUEPRINT_MODEL_NAME=Qwen3.8-27B
BLUEPRINT_MODEL_APPROVED_HOSTS=litemaas.rhoai.rh-aiservices-bu.com
BLUEPRINT_MODEL_API_KEY_ENV=LITEMAAS_API_KEY
# Use instead of enMaaS: BLUEPRINT_ENTERPRISE_ENV=profiles/enterprise-litemaas.env scripts/start.sh enterprise
