{
  "$schema": "https://opencode.ai/config.json",
  // Default: the same private gateway and model as the Java agent's enterprise profile (profiles/enterprise.env).
  // Offline: pick "Ollama (local)" with /models, or start with: opencode -m ollama/qwen3:4b-instruct
  // Keys are read from the environment; never put them in this file.
  "model": "enmaas/rits/deepseek-ai/DeepSeek-V4.1-Flash-1017",
  "provider": {
    "enmaas": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Red Hat enMaaS",
      "options": {
        "baseURL": "https://api.enmaas.devshift.net/v1",
        "apiKey": "{env:ENMAAS_KEY}"
      },
      "models": {
        "rits/deepseek-ai/DeepSeek-V4.1-Flash-1017": {
          "name": "DeepSeek V4.1 Flash (enMaaS)",
          "reasoning": false
        },
        "rits/zai-org/glm-5-3": {
          "name": "GLM 5.3 (enMaaS)"
        }
      }
    },
    "ollama": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Ollama (local)",
      "options": {
        "baseURL": "http://127.0.0.1:11434/v1"
      },
      "models": {
        "qwen3:4b-instruct": {
          "name": "Qwen3 4B Instruct (local)"
        }
      }
    },
    "private-provider": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "LiteMaaS AI Gateway",
      "options": {
        "baseURL": "https://litemaas.rhoai.rh-aiservices-bu.com/v1",
        "apiKey": "{env:LITEMAAS_API_KEY}"
      },
      "models": {
        "Qwen3.8-27B": {
          "name": "Qwen 3.8 (27B)",
          "reasoning": false
        }
      }
    }
  },
  "agent": {
    "build": {
      "steps": 12,
      "temperature": 0
    }
  }
}
